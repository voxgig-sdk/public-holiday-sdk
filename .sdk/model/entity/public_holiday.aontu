# Entity: public_holiday

main: kit: entity: public_holiday: {

  alias: field: {}

  fields: {
    counties: {
      h: "Counties"
      n: "counties"
      r: false
      sh: "If it is not global you found here the Federal states (ISO-3166-2)"
      t: "`$ARRAY`"
    }
    countryCode: {
      h: "Country Code"
      n: "countryCode"
      r: false
      sh: "ISO 3166-1 alpha-2 country code"
      t: "`$STRING`"
    }
    date: {
      fo: "date"
      h: "Date"
      n: "date"
      r: false
      sh: "The date of the holiday"
      t: "`$STRING`"
    }
    fixed: {
      h: "Fixed"
      n: "fixed"
      r: false
      sh: "Is this public holiday every year on the same date"
      t: "`$BOOLEAN`"
    }
    global: {
      h: "Global"
      n: "global"
      r: false
      sh: "Is this public holiday in every county (federal state)"
      t: "`$BOOLEAN`"
    }
    launchYear: {
      h: "Launch Year"
      n: "launchYear"
      r: false
      sh: "The launch year of the public holiday"
      t: "`$INTEGER`"
    }
    localName: {
      h: "Local Name"
      n: "localName"
      r: false
      sh: "Local name of the holiday"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "English name of the holiday"
      t: "`$STRING`"
    }
    types: {
      h: "Types"
      n: "types"
      r: false
      sh: "The types of the public holiday."
      t: "`$ARRAY`"
    }
  }

  name: "public_holiday"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /PublicHolidays/{Year}/{CountryCode}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "AT"
                k: "param"
                n: "country_code"
                or: "CountryCode"
                r: true
                t: "`$STRING`"
              }
              {
                ex: 2026
                k: "param"
                n: "year"
                or: "Year"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/PublicHolidays/{Year}/{CountryCode}"
          q: {
            exist: [
              "country_code"
              "year"
            ]
          }
          r: {
            param: {
              CountryCode: "country_code"
              Year: "year"
            }
          }
          s: [
            {
              lit: "PublicHolidays"
            }
            {
              var: "year"
            }
            {
              var: "country_code"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /NextPublicHolidaysWorldwide"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/NextPublicHolidaysWorldwide"
          s: [
            {
              lit: "NextPublicHolidaysWorldwide"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /IsTodayPublicHoliday/{CountryCode}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "AT"
                k: "param"
                n: "country_code"
                or: "CountryCode"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "offset"
                or: "offset"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/IsTodayPublicHoliday/{CountryCode}"
          q: {
            exist: [
              "country_code"
              "offset"
            ]
          }
          r: {
            param: {
              CountryCode: "country_code"
            }
          }
          s: [
            {
              lit: "IsTodayPublicHoliday"
            }
            {
              var: "country_code"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /NextPublicHolidays/{CountryCode}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "AT"
                k: "param"
                n: "country_code"
                or: "CountryCode"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/NextPublicHolidays/{CountryCode}"
          q: {
            exist: [
              "country_code"
            ]
          }
          r: {
            param: {
              CountryCode: "country_code"
            }
          }
          s: [
            {
              lit: "NextPublicHolidays"
            }
            {
              var: "country_code"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
