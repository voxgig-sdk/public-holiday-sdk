              }
            ]
          }
          method: "GET"
          orig: "/NextPublicHolidays/{CountryCode}"
          rename: {
            param: {
              CountryCode: "country_code"
            }
          }
          segments: [
            {
              lit: "NextPublicHolidays"
            }
            {
              var: "country_code"
            }
          ]
          select: {
