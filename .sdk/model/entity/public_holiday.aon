                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/IsTodayPublicHoliday/{CountryCode}"
          rename: {
            param: {
              CountryCode: "country_code"
            }
          }
          segments: [
            {
              lit: "IsTodayPublicHoliday"
            }
            {
              var: "country_code"
            }
          ]
          select: {
            exist: [
              "country_code"
              "offset"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                example: "AT"
                kind: "param"
                name: "country_code"
                orig: "country_code"
