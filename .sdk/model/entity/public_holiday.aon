          rename: {
            param: {
              CountryCode: "country_code"
              Year: "year"
            }
          }
          segments: [
            {
              lit: "PublicHolidays"
            }
            {
              var: "year"
            }
            {
              var: "country_code"
            }
          ]
          select: {
            exist: [
              "country_code"
              "year"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
