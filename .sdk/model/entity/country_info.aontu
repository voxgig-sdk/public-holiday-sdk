    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "country_info"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /CountryInfo/{CountryCode}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "AT"
                k: "param"
                n: "id"
                or: "country_code"
