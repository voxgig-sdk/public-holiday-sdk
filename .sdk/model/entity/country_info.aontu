      r: false
      sh: "Bordering countries"
      t: "`$ARRAY`"
    }
    commonName: {
      h: "Common Name"
      n: "commonName"
      r: false
      sh: "Common name of the country"
      t: "`$STRING`"
    }
    countryCode: {
      h: "Country Code"
      n: "countryCode"
      r: false
      sh: "ISO 3166-1 alpha-2 country code"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    officialName: {
      h: "Official Name"
      n: "officialName"
      r: false
