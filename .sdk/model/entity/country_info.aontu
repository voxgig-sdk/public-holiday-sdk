            ]
          }
          r: {
            param: {
              CountryCode: "id"
            }
          }
          s: [
            {
              lit: "CountryInfo"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



