# Entity: long_weekend

main: kit: entity: long_weekend: {

  alias: field: {}

  fields: [
    {
      name: "dayCount"
      req: false
      short: "Number of days in the long weekend"
      type: "`$INTEGER`"
    }
    {
      format: "date"
      name: "endDate"
      req: false
      short: "End date of the long weekend"
      type: "`$STRING`"
    }
    {
      name: "needBridgeDay"
      req: false
      short: "Whether a bridge day is needed"
      type: "`$BOOLEAN`"
    }
    {
      format: "date"
      name: "startDate"
      req: false
      short: "Start date of the long weekend"
      type: "`$STRING`"
    }
  ]

  name: "long_weekend"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: "AT"
                kind: "param"
                name: "country_code"
                orig: "country_code"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: 2026
                kind: "param"
                name: "year"
                orig: "year"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/LongWeekend/{Year}/{CountryCode}"
          rename: {
            param: {
              CountryCode: "country_code"
              Year: "year"
            }
          }
          segments: [
            {
              lit: "LongWeekend"
            }
            {
              var: "year"
            }
            {
              var: "country_code"
            }
          ]
          select: {
            exist: [
              "country_code"
              "year"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "long_weekend"
      ]
    ]
  }



}
